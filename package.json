{
  "name": "@kirha/ai-sdk",
  "version": "0.1.1",
  "description": "AI SDK tools for Kirha Search API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && bun run build:types",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "bun test",
    "lint": "biome check --write",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "kirha",
    "search",
    "ai",
    "ai-sdk",
    "vercel",
    "tools",
    "data"
  ],
  "author": "Kirha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirha-ai/ai-sdk"
  },
  "dependencies": {
    "kirha": "^0.1.1"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@ai-sdk/google": "^3.0.21",
    "@biomejs/biome": "2.3.10",
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
